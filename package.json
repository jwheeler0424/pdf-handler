{
  "name": "pdf-parser",
  "version": "0.0.1",
  "description": "A library tool to help interact with PDF files in a Node.js environment.",
  "license": "LGPL-3.0-or-later",
  "author": {
    "name": "Jonathan Wheeler",
    "email": "jonathan@designersimage.io"
  },
  "main": "dist/index.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "build": "tsc",
